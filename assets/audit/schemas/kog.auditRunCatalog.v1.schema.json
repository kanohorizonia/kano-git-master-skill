{
  "$id": "https://schemas.kanohorizonia.dev/kog/kog.auditRunCatalog.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KOG Audit Run Catalog v1",
  "description": "Closed discovery-only projections. Catalog rows are not evidence and must be revalidated with the pinned attempt reader.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaName", "schemaVersion", "entries"],
  "properties": {
    "schemaName": {"const": "kog.auditRunCatalog"},
    "schemaVersion": {"const": 1},
    "entries": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObjectId": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "outcome": {"enum": ["succeeded", "failed", "partial", "blocked", "cancelled", "timed-out", "unknown"]},
    "stableId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$"},
    "utc": {"type": "string", "minLength": 20, "maxLength": 20, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["repositoryId", "afterHeadSha"],
      "properties": {"repositoryId": {"$ref": "#/$defs/stableId"}, "afterHeadSha": {"anyOf": [{"$ref": "#/$defs/gitObjectId"}, {"type": "null"}]}}
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["runId", "parentRunId", "attempt", "inputKind", "route", "planId", "planSha256", "sourceSha256", "sourceSizeBytes", "auditRootSelector", "auditRootSha256", "state", "outcome", "repositories", "repositoryIdentityHeadSha256", "correlationSha256", "observedAtUtc", "receiptSha256", "finishedAtUtc", "redaction", "truncation"],
      "properties": {
        "runId": {"$ref": "#/$defs/stableId"}, "parentRunId": {"anyOf": [{"$ref": "#/$defs/stableId"}, {"type": "null"}]},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 4294967295}, "inputKind": {"enum": ["commit-plan", "operation-descriptor"]}, "route": {"enum": ["commit.plan", "commit-push.plan", "plan.apply", "converge.repos", "converge.branches.apply", "converge.branches.recover", "converge.branches.retire"]}, "planId": {"$ref": "#/$defs/stableId"},
        "planSha256": {"$ref": "#/$defs/sha256"}, "sourceSha256": {"$ref": "#/$defs/sha256"}, "sourceSizeBytes": {"type": "integer", "minimum": 0, "maximum": 4194304}, "auditRootSelector": {"type": "string", "pattern": "^(plan|operation)-[0-9a-f]{64}$"}, "auditRootSha256": {"$ref": "#/$defs/sha256"},
        "state": {"enum": ["pending", "incomplete", "final"]},
        "outcome": {"anyOf": [{"$ref": "#/$defs/outcome"}, {"type": "null"}]},
        "repositories": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/repository"}},
        "repositoryIdentityHeadSha256": {"type": "string", "maxLength": 64, "pattern": "^(?:[0-9a-f]{64})?$"},
        "correlationSha256": {"$ref": "#/$defs/sha256"}, "observedAtUtc": {"$ref": "#/$defs/utc"},
        "receiptSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "finishedAtUtc": {"anyOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]},
        "redaction": {"type": "object", "additionalProperties": false, "required": ["redacted", "withheld"], "properties": {"redacted": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "withheld": {"type": "integer", "minimum": 0, "maximum": 4294967295}}},
        "truncation": {"type": "object", "additionalProperties": false, "required": ["omittedEvents", "omittedRepositories", "omittedEvidence"], "properties": {"omittedEvents": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "omittedRepositories": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "omittedEvidence": {"type": "integer", "minimum": 0, "maximum": 4294967295}}}
      },
      "allOf": [
        {"if": {"properties": {"inputKind": {"const": "commit-plan"}}}, "then": {"properties": {"route": {"enum": ["commit.plan", "commit-push.plan", "plan.apply"]}, "auditRootSelector": {"pattern": "^plan-[0-9a-f]{64}$"}}}},
        {"if": {"properties": {"inputKind": {"const": "operation-descriptor"}}}, "then": {"properties": {"route": {"enum": ["converge.repos", "converge.branches.apply", "converge.branches.recover", "converge.branches.retire"]}, "auditRootSelector": {"pattern": "^operation-[0-9a-f]{64}$"}}}},
        {"if": {"properties": {"state": {"const": "final"}}}, "then": {"properties": {"outcome": {"$ref": "#/$defs/outcome"}, "receiptSha256": {"$ref": "#/$defs/sha256"}, "finishedAtUtc": {"$ref": "#/$defs/utc"}, "repositoryIdentityHeadSha256": {"$ref": "#/$defs/sha256"}}}},
        {"if": {"properties": {"state": {"const": "pending"}}}, "then": {"properties": {"outcome": {"type": "null"}, "receiptSha256": {"type": "null"}, "finishedAtUtc": {"type": "null"}, "repositoryIdentityHeadSha256": {"const": ""}}}},
        {"if": {"properties": {"state": {"const": "incomplete"}}}, "then": {"properties": {"outcome": {"type": "null"}, "receiptSha256": {"type": "null"}, "finishedAtUtc": {"$ref": "#/$defs/utc"}, "repositoryIdentityHeadSha256": {"const": ""}}}}
      ]
    }
  }
}
