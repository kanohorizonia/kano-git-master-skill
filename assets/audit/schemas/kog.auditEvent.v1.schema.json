{
  "$id": "https://schemas.kanohorizonia.dev/kog/kog.auditEvent.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KOG AuditEvent v1",
  "description": "One canonical JSONL record describing a completed semantic KOG action.",
  "type": "object",
  "required": [
    "schemaName",
    "schemaVersion",
    "eventId",
    "runId",
    "parentRunId",
    "attempt",
    "planId",
    "planSha256",
    "sequence",
    "startedAtUtc",
    "finishedAtUtc",
    "repository",
    "phase",
    "action",
    "outcome",
    "correlation",
    "policyRefs",
    "approvalRefs",
    "artifacts"
  ],
  "properties": {
    "schemaName": {
      "const": "kog.auditEvent"
    },
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "$ref": "#/$defs/opaqueId"
    },
    "runId": {
      "$ref": "#/$defs/opaqueId"
    },
    "parentRunId": {
      "$ref": "#/$defs/nullableOpaqueId"
    },
    "attempt": {
      "$ref": "#/$defs/positiveUint32"
    },
    "planId": {
      "$ref": "#/$defs/opaqueId"
    },
    "planSha256": {
      "$ref": "#/$defs/sha256"
    },
    "sequence": {
      "$ref": "#/$defs/positiveSafeInteger"
    },
    "startedAtUtc": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "finishedAtUtc": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "repository": {
      "$ref": "#/$defs/repositoryTransition"
    },
    "phase": {
      "$ref": "#/$defs/semanticToken"
    },
    "action": {
      "$ref": "#/$defs/semanticToken"
    },
    "outcome": {
      "$ref": "#/$defs/outcome"
    },
    "correlation": {
      "$ref": "#/$defs/correlation"
    },
    "policyRefs": {
      "$ref": "#/$defs/auditReferences"
    },
    "approvalRefs": {
      "$ref": "#/$defs/auditReferences"
    },
    "artifacts": {
      "$ref": "#/$defs/artifactReferences"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "positiveUint32": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Legacy v1 printable opaque ID.",
      "pattern": "^[!-~]+$(?![\\s\\S])"
    },
    "stableCorrelationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Stable, path-free correlation ID. Secret-shaped prefixes and dot-dot segments are forbidden.",
      "pattern": "^(?!.*\\.\\.)(?![sS][kK]-)(?![gG][hH][pP]_)(?![gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_)(?![gG][lL][pP][aA][tT]-)(?![bB][eE][aA][rR][eE][rR])(?!(?:[aA][kK][iI][aA]))[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$(?![\\s\\S])"
    },
    "repositoryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*\\/$)[!-~]+$(?![\\s\\S])"
    },
    "nullableOpaqueId": {
      "oneOf": [
        {
          "$ref": "#/$defs/opaqueId"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableStableCorrelationId": {
      "oneOf": [
        {
          "$ref": "#/$defs/stableCorrelationId"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$(?![\\s\\S])"
    },
    "nullableGitOid": {
      "oneOf": [
        {
          "$ref": "#/$defs/gitOid"
        },
        {
          "type": "null"
        }
      ]
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"
    },
    "semanticToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9._-]*$(?![\\s\\S])"
    },
    "nullableText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableSafeInteger": {
      "oneOf": [
        {
          "$ref": "#/$defs/safeInteger"
        },
        {
          "type": "null"
        }
      ]
    },
    "repositoryState": {
      "type": "object",
      "required": [
        "headSha",
        "branch",
        "worktreeState",
        "dirtyFingerprint",
        "upstreamHeadSha",
        "ahead",
        "behind"
      ],
      "properties": {
        "headSha": {
          "$ref": "#/$defs/nullableGitOid"
        },
        "branch": {
          "$ref": "#/$defs/nullableText"
        },
        "worktreeState": {
          "enum": [
            "clean",
            "dirty",
            "unknown"
          ]
        },
        "dirtyFingerprint": {
          "$ref": "#/$defs/nullableSha256"
        },
        "upstreamHeadSha": {
          "$ref": "#/$defs/nullableGitOid"
        },
        "ahead": {
          "$ref": "#/$defs/nullableSafeInteger"
        },
        "behind": {
          "$ref": "#/$defs/nullableSafeInteger"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "worktreeState": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "dirtyFingerprint": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "dirtyFingerprint": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "upstreamHeadSha": {
                  "type": "null"
                },
                "ahead": {
                  "type": "null"
                },
                "behind": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "upstreamHeadSha": {
                  "$ref": "#/$defs/gitOid"
                },
                "ahead": {
                  "$ref": "#/$defs/safeInteger"
                },
                "behind": {
                  "$ref": "#/$defs/safeInteger"
                }
              }
            }
          ]
        }
      ],
      "additionalProperties": false
    },
    "repositoryTransition": {
      "type": "object",
      "required": [
        "id",
        "before",
        "after"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/repositoryId"
        },
        "before": {
          "$ref": "#/$defs/repositoryState"
        },
        "after": {
          "$ref": "#/$defs/repositoryState"
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": [
        "status",
        "exitCode",
        "reasonCode",
        "retryable"
      ],
      "properties": {
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "partial",
            "blocked",
            "cancelled",
            "timed-out",
            "unknown"
          ]
        },
        "exitCode": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "reasonCode": {
          "$ref": "#/$defs/nullableOpaqueId"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "exitCode": {
                "enum": [
                  0,
                  null
                ]
              },
              "reasonCode": {
                "type": "null"
              },
              "retryable": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "reasonCode": {
                "$ref": "#/$defs/opaqueId"
              },
              "exitCode": {
                "not": {
                  "const": 0
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "correlation": {
      "type": "object",
      "required": [
        "mode",
        "productId",
        "topicId",
        "itemId",
        "workOrderId",
        "requestId",
        "producerId",
        "routeId",
        "agentId"
      ],
      "properties": {
        "mode": {
          "enum": [
            "standalone",
            "koa"
          ]
        },
        "productId": {
          "$ref": "#/$defs/nullableStableCorrelationId"
        },
        "topicId": {
          "$ref": "#/$defs/nullableStableCorrelationId"
        },
        "itemId": {
          "$ref": "#/$defs/nullableStableCorrelationId"
        },
        "workOrderId": {
          "$ref": "#/$defs/nullableStableCorrelationId"
        },
        "requestId": {
          "$ref": "#/$defs/nullableStableCorrelationId"
        },
        "producerId": {
          "$ref": "#/$defs/nullableStableCorrelationId"
        },
        "routeId": {
          "$ref": "#/$defs/nullableStableCorrelationId"
        },
        "agentId": {
          "$ref": "#/$defs/nullableStableCorrelationId"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "standalone"
              }
            }
          },
          "then": {
            "properties": {
              "productId": {
                "type": "null"
              },
              "topicId": {
                "type": "null"
              },
              "itemId": {
                "type": "null"
              },
              "workOrderId": {
                "type": "null"
              },
              "requestId": {
                "type": "null"
              },
              "producerId": {
                "type": "null"
              },
              "routeId": {
                "type": "null"
              },
              "agentId": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "productId": {
                "$ref": "#/$defs/stableCorrelationId"
              },
              "itemId": {
                "$ref": "#/$defs/stableCorrelationId"
              },
              "workOrderId": {
                "$ref": "#/$defs/stableCorrelationId"
              },
              "requestId": {
                "$ref": "#/$defs/stableCorrelationId"
              },
              "producerId": {
                "$ref": "#/$defs/stableCorrelationId"
              },
              "routeId": {
                "$ref": "#/$defs/stableCorrelationId"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "auditReference": {
      "type": "object",
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/opaqueId"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "auditReferences": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/auditReference"
      }
    },
    "artifactReference": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "sha256",
        "sizeBytes",
        "contentType",
        "redactionStatus"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/opaqueId"
        },
        "kind": {
          "$ref": "#/$defs/semanticToken"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sizeBytes": {
          "$ref": "#/$defs/safeInteger"
        },
        "contentType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[!-.0-~]+/[!-.0-~]+$(?![\\s\\S])"
        },
        "redactionStatus": {
          "enum": [
            "not-required",
            "redacted",
            "withheld"
          ]
        }
      },
      "additionalProperties": false
    },
    "artifactReferences": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/artifactReference"
      }
    }
  }
}
