{
  "schema": "kog.runtime.artifact.v1",
  "version": "@KOG_BUILD_VERSION_STR@",
  "revision": "@KOG_BUILD_REVISION_HASH_STR@",
  "source_fingerprint": "@KOG_RUNTIME_SOURCE_FINGERPRINT@",
  "build_context": "@KOG_BUILD_CONTEXT_STR@",
  "toolchain": "@KOG_BUILD_TOOLCHAIN_STR@",
  "configuration": "@KOG_BUILD_CONFIGURATION_STR@",
  "binary": "bin/kano-git",
  "runtime_assets": [
    "SKILL.md",
    "assets/regression/incidents.json",
    "assets/regression/case-template.json",
    "assets/audit/schemas/kog.auditEvent.v1.schema.json",
    "assets/audit/schemas/kog.runReceipt.v1.schema.json",
    "assets/audit/schemas/kog.auditCapability.v1.schema.json",
    "assets/audit/schemas/kog.auditVerification.v1.schema.json"
  ]
}
